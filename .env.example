# ── Engine binding ────────────────────────────────────────────────────────
# live = console calls the reasoning pipeline (LLM translation + Z3
#        verification) over REST. Default in deployed environments.
# mock = seeded in-process engine; deterministic, offline. UI dev and tests.
NEXT_PUBLIC_ENGINE_MODE=live

# ── Language layer (translation only — the LLM never makes the decision) ──
# Any OpenAI-compatible chat endpoint works; the demonstration deployment
# uses MiniMax. For sovereign setups point this at a self-hosted EU model
# (Ollama / vLLM). See docs/deployment.md §4.
MINIMAX_API_KEY=your-api-key-here
MINIMAX_MODEL=MiniMax-Text-01
MINIMAX_API_BASE=https://api.minimax.io/v1
